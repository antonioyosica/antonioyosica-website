# Sem chave, o concierge usa o encaminhador local. Com chave, usa Claude.
NUXT_ANTHROPIC_KEY=
NUXT_PUBLIC_CONTACT_EMAIL=
# Opcional: URL do teu calendário (Cal.com, Calendly). Se vazio, /agendar usa o formulário.
NUXT_PUBLIC_BOOKING_URL=
# Opcional: Slack/Make/Zapier recebe cada pedido (sessão/evento).
NUXT_LEAD_WEBHOOK=
# Subdomínios (produção). Em dev deixa vazio: a loja fica em /loja
NUXT_PUBLIC_LOJA_HOST=loja.antonioyosica.com
NUXT_PUBLIC_MAIN_HOST=antonioyosica.com
